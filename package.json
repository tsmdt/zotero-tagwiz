{
  "name": "zotero-tagwiz",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "version": "0.1.0",
  "description": "Bulk-clean Zotero tags: change case, unify, remove, and merge duplicates.",
  "config": {
    "addonName": "TagWiz",
    "addonID": "tagwiz@tsmdt.github.io",
    "addonRef": "tagwiz",
    "addonInstance": "TagWiz",
    "prefsPrefix": "extensions.zotero.tagwiz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsmdt/zotero-tagwiz.git"
  },
  "author": "Thomas Schmidt",
  "bugs": {
    "url": "https://github.com/tsmdt/zotero-tagwiz/issues"
  },
  "homepage": "https://github.com/tsmdt/zotero-tagwiz#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "test:unit": "mocha --import=tsx \"test/unit/**/*.test.ts\"",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
